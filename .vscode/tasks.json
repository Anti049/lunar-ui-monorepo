{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "check",
			"type": "shell",
			"command": "bun run check",
			// Puts TypeScript errors in the Problems panel with clickable
			// locations, rather than leaving them as terminal text.
			"problemMatcher": ["$tsc"],
			// Binds this to the run-test-task keybinding, which is worth having
			// on one key.
			"group": { "kind": "test", "isDefault": true }
		},
		{
			"label": "build plugin",
			"type": "shell",
			"command": "bun run --filter '@anti049/lunar-ui' build",
			"problemMatcher": ["$tsc"]
		},
		{
			"label": "dev",
			"type": "shell",
			"command": "bun run dev",
			// Long-running: VS Code should not wait for it to exit.
			"isBackground": true,
			"problemMatcher": []
		}
	]
}
