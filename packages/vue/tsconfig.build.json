{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		// Declarations only — Vite already emitted the JS. The checker config
		// this extends sets noEmit, which would otherwise silently emit nothing.
		"noEmit": false,
		"declaration": true,
		"emitDeclarationOnly": true,
		"outDir": "dist",
		// So `src/lib/index.ts` lands at `dist/index.d.ts`, where exports points.
		"rootDir": "src/lib"
	},
	// The library only: the demo app and vite.config.ts are not published.
	"include": ["src/lib/**/*.ts", "src/lib/**/*.vue"]
}
