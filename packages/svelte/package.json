{
	"name": "@anti049/lunar-ui-svelte",
	"version": "0.1.0",
	"type": "module",
	"license": "MIT",
	"description": "Svelte 5 components for the test design system.",
	"keywords": [
		"svelte",
		"tailwindcss",
		"ui",
		"components",
		"design-system"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Anti049/lunar-ui-monorepo.git",
		"directory": "packages/svelte"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "svelte-package && publint",
		"check": "svelte-check --tsconfig ./tsconfig.json",
		"prepare": "svelte-kit sync"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"files": [
		"dist"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./styles.css": "./dist/styles.css",
		"./package.json": "./package.json"
	},
	"sideEffects": [
		"**/*.css"
	],
	"peerDependencies": {
		"@anti049/lunar-ui": "^0.1.0",
		"svelte": "^5.0.0"
	},
	"dependencies": {
		"clsx": "^2.1.1",
		"tailwind-merge": "^3.7.0"
	},
	"devDependencies": {
		"@anti049/lunar-ui": "workspace:*",
		"@sveltejs/kit": "^3.1.0",
		"@sveltejs/package": "^3.0.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.3",
		"publint": "^0.3.24",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.7",
		"tailwindcss": "^4.3.3",
		"typescript": "~6.0.3",
		"vite": "^8.3.5"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	}
}
